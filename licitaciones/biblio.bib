@misc{GarciaRodriguezArosa2021,
	author = {Manuel J. Garc\'{i}a Rodr\'{i}guez and Daniel Arosa},
	title = {Public Procurement in Spain: Data Sources, Regulations, and Technological Applications},
	year = {2021},
	month = {dec},  % Se usa 'dec' en vez de '12' para compatibilidad con BibTeX
	abstract = {Open data from public administrations, and, in particular, public procurement-related data, is a powerful source of information for supporting the decision-making process, both for public administrations and economic operators. In this paper, we present the current situation of the public procurement framework in Spain, including challenges, regulatory framework, and main stakeholders involved in the process (contracting authorities, platforms, oversight authorities, etc.). Finally, we present several use cases that, through the application of innovative technologies (mainly Big Data, Artificial Intelligence, and Process Automation), could solve some of the current public procurement challenges, increase the efficiency of public procurement processes, and provide tools for public sector managers to facilitate decision-making.},
	issn = {2007-3798},
